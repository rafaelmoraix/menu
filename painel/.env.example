# Copie para .env e preencha.
# Chave da API (pegue na página Account do baratoebom.com). Sem ela, o painel roda em modo demonstração.
API_KEY=
# URL da API (normalmente não precisa mudar)
API_URL=https://baratoebom.com/api/v2
# Porta e endereço do servidor. Use HOST=0.0.0.0 para acessar de outros aparelhos da rede.
PORT=3000
HOST=127.0.0.1
# Senha de acesso ao painel (recomendado se HOST não for 127.0.0.1). Usuário: qualquer.
APP_PASSWORD=
# Force o modo demonstração mesmo com chave
# MOCK=1
